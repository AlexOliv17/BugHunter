# Copie para app/.env.local e preencha. Nunca versione o .env.local.

# Supabase — URL raiz do projeto (https://<ref>.supabase.co, sem /rest/v1)
# e chave publishable (sb_publishable_...). Vão ao navegador; protegidas por RLS e grants.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — chave secret (sb_secret_...). SOMENTE SERVIDOR.
# Nunca prefixar com NEXT_PUBLIC_; nunca repassar ao processo que executa código de aluno.
SUPABASE_SERVICE_ROLE_KEY=

# Modelo de linguagem do feedback final (RF-15). SOMENTE SERVIDOR.
# FEEDBACK_MODEL aceita uma lista separada por vírgulas, tentada em ordem dentro de 15 s
# (escolha da S5-02: gemini-3.1-flash-lite,gemini-3.5-flash-lite).
FEEDBACK_API_KEY=
FEEDBACK_MODEL=

# Executor do Verificar (DA-08): projeto Vercel separado. SOMENTE SERVIDOR.
# EXECUTOR_URL termina em /api/executar. O mesmo EXECUTOR_SEGREDO vai nos dois projetos.
# Em desenvolvimento: python executor/servidor_local.py e EXECUTOR_URL=http://127.0.0.1:3071/api/executar
EXECUTOR_URL=
EXECUTOR_SEGREDO=
