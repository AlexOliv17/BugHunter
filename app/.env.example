# Copie para app/.env.local e preencha. Nunca versione o .env.local.

# Supabase — públicas (vão ao navegador; protegidas por RLS e grants)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — chave de serviço. SOMENTE SERVIDOR.
# Nunca prefixar com NEXT_PUBLIC_; nunca repassar ao processo que executa código de aluno.
SUPABASE_SERVICE_ROLE_KEY=

# Modelo de linguagem do feedback final (RF-15). SOMENTE SERVIDOR.
FEEDBACK_API_KEY=
FEEDBACK_MODEL=
